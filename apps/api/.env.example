APP_NAME=PhishShield AI API
APP_VERSION=1.0.0-rc1
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL=INFO
# Development default is true. Set false in production when structured
# phishshield.request events are the preferred access-log source.
UVICORN_ACCESS_LOG=true
MAX_REQUEST_BYTES=2200000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_HEALTH=300
RATE_LIMIT_PARSER=60
RATE_LIMIT_ANALYSIS=120
TRUSTED_PROXY_IPS=
ML_REGISTRY_PATH=services/ml/models/registry.json
ML_MODEL_ID=phase-c-logistic-regression-v1
ML_MARGINAL_ALERT_BAND=0.08
# Optional: a mounted/downloaded copy of the approved artifact. Its SHA-256
# must match the selected registry entry before it can be loaded.
ML_ARTIFACT_PATH=
ML_REQUIRED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Deployment-only provisioning variables; leave unset for local development.
# MODEL_ARTIFACT_URL=https://private-artifact.example.invalid/model.joblib
# MODEL_ARTIFACT_TOKEN=
# ML_EXPECTED_SHA256=
# MODEL_ARTIFACT_MAX_BYTES=10485760
# MODEL_ARTIFACT_TIMEOUT_SECONDS=30
