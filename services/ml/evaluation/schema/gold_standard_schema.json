{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phishshield://evaluation/gold-standard-schema/1.0",
  "title": "PhishPhage AI Gold-Standard Evaluation Sample",
  "description": "Privacy-safe metadata for a manually reviewed evaluation sample. Raw content is never embedded in this record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sample_id",
    "expected_class",
    "source_dataset",
    "source_record_id",
    "campaign",
    "sample_date",
    "language",
    "sender_domain",
    "claimed_organization",
    "attachment_present",
    "attachment_types",
    "url_present",
    "url_count",
    "email_format",
    "review_status",
    "reviewer_count",
    "adjudication_status",
    "labeling_notes",
    "privacy_status",
    "content_location",
    "content_hash",
    "schema_version"
  ],
  "properties": {
    "sample_id": {"type": "string", "pattern": "^gs-[a-f0-9]{20}$"},
    "expected_class": {"type": ["string", "null"], "enum": ["safe", "suspicious", "phishing", null]},
    "source_dataset": {"type": "string", "minLength": 1},
    "source_record_id": {"type": "string", "minLength": 1},
    "campaign": {"type": "string", "minLength": 1},
    "sample_date": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 1},
    "sender_domain": {"type": "string", "minLength": 1},
    "claimed_organization": {"type": "string", "minLength": 1},
    "attachment_present": {"type": "boolean"},
    "attachment_types": {"type": "array", "items": {"type": "string"}},
    "url_present": {"type": "boolean"},
    "url_count": {"type": "integer", "minimum": 0},
    "email_format": {"type": "string", "enum": ["raw_rfc822", "raw_text", "quick_paste", "unknown"]},
    "review_status": {"type": "string", "enum": ["unreviewed", "provisional", "adjudicated", "conflict", "excluded"]},
    "reviewer_count": {"type": "integer", "minimum": 0, "maximum": 2},
    "adjudication_status": {"type": "string", "enum": ["not_started", "provisional", "complete", "conflict", "excluded"]},
    "labeling_notes": {"type": "string", "minLength": 1},
    "privacy_status": {"type": "string", "enum": ["pending", "pass", "fail"]},
    "content_location": {"type": "string", "pattern": "^(local-only://|relative://)[^\\r\\n]+$"},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "schema_version": {"const": "gold-standard-1.0"},
    "category": {"type": ["string", "null"]},
    "subset": {"type": "string", "enum": ["development_diagnostic", "independent_validation", "challenge", "category_stress", "unassigned"]},
    "reviewer_1_label": {"type": ["string", "null"], "enum": ["safe", "suspicious", "phishing", null]},
    "reviewer_2_label": {"type": ["string", "null"], "enum": ["safe", "suspicious", "phishing", null]},
    "adjudicated_label": {"type": ["string", "null"], "enum": ["safe", "suspicious", "phishing", null]},
    "disagreement_reason": {"type": ["string", "null"]},
    "adjudication_notes": {"type": ["string", "null"]},
    "final_reviewer": {"type": ["string", "null"]},
    "final_review_date": {"type": ["string", "null"]},
    "reviewer_1_confidence": {"type": ["string", "null"]},
    "reviewer_2_confidence": {"type": ["string", "null"]},
    "overlap_status": {"type": "string", "enum": ["unknown", "pass", "fail", "excluded"]},
    "training_overlap": {"type": "boolean"},
    "development_overlap": {"type": "boolean"},
    "duplicate_status": {"type": "string", "enum": ["unknown", "pass", "fail", "excluded"]},
    "content_exists": {"type": "boolean"},
    "content_hash_stable": {"type": "boolean"},
    "candidate_category": {"type": ["string", "null"], "description": "Optional reviewer aid only; never ground truth."},
    "exclusion_reason": {"type": ["string", "null"]},
    "subject_redacted": {"type": "string", "minLength": 1},
    "normalized_content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "normalized_body_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "x-validation": {
    "sample_id": "Unique within a manifest and deterministic from source identity plus canonical content hash.",
    "expected_class": "Null is permitted only before manual review; final benchmark records must use safe, suspicious, or phishing.",
    "campaign": "Use an evidence-backed campaign identifier or the explicit value unknown; never derive a label from it.",
    "sample_date": "Use an evidence-backed date or the explicit value unknown.",
    "language": "Use an audited language code or the explicit value unknown.",
    "content_location": "Public records use a local-only token. Absolute paths and raw content belong only in ignored private manifests.",
    "privacy": "No raw email, full address, phone number, private header, token, live URL, or attachment may be embedded.",
    "eligibility": "The independent benchmark requires privacy pass, known source, stable content, no overlap, no duplicate conflict, and complete adjudication."
  }
}
